# ============================================================
#  BT2 Inversiones · Configuración del servidor (Apache / Arsys)
# ============================================================

Options -Indexes
ServerSignature Off
DirectoryIndex index.html
ErrorDocument 404 /404.html

# --- Forzar HTTPS y dominio con www -------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.bt2.es%{REQUEST_URI} [L,R=301]

  # Bloquear archivos ocultos (.git, .env…) salvo .well-known
  RewriteRule "(^|/)\.(?!well-known/)" - [F]
</IfModule>

# --- Cabeceras de seguridad ---------------------------------
<IfModule mod_headers.c>
  # Solo HTTPS durante 1 año (activar includeSubDomains solo si TODOS los subdominios tienen certificado)
  Header always set Strict-Transport-Security "max-age=31536000"
  # Solo recursos propios; sin scripts; no se puede incrustar en otras webs
  Header always set Content-Security-Policy "default-src 'self'; script-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header unset X-Powered-By
  Header always unset X-Powered-By

  # Caché: HTML siempre fresco; recursos 1 año
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|webp|png|svg|woff2|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# --- Compresión ----------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml image/svg+xml
</IfModule>

# --- Tipos de archivo ----------------------------------------
AddType font/woff2 .woff2
AddType image/webp .webp
AddDefaultCharset UTF-8
